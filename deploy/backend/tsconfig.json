{
  "include": ["src/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "lib": ["es2022"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  }
}
