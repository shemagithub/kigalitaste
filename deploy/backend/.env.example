MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_cpanel_db_user
MYSQL_PASSWORD=
MYSQL_DATABASE=your_cpanel_db_name
PORT=5050

# Change this in production (signs login tokens)
JWT_SECRET=change-me-to-a-long-random-string

# Public CUSTOMER site (frontend) — emails, sitemap, payment return
PUBLIC_APP_URL=https://kigalitaste.co
PAYMENT_PUBLIC_URL=https://kigalitaste.co

# Business email (cPanel SMTP port 465 SSL)
MAIL_HOST=kigalitaste.co
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=info@kigalitaste.co
MAIL_PASS=
MAIL_FROM=info@kigalitaste.co
BUSINESS_NOTIFY_EMAIL=info@kigalitaste.co

# IMAP inbox sync (receive emails into admin mailbox)
IMAP_HOST=kigalitaste.co
IMAP_PORT=993
# MAILBOX_SYNC_MS=120000

XENTRIPAY_API_KEY=
XENTRIPAY_WEBHOOK_SECRET=
XENTRIPAY_BASE_URL=https://xentripay.com
