Options -MultiViews
RewriteEngine On

# Do not force HTTPS. Some phones and networks cannot complete SSL
# to the API host; the browser stays on this site and proxy.php talks
# to the Node backend over HTTP (or HTTPS with cert checks off).

RewriteRule ^proxy\.php$ - [L]

RewriteCond %{REQUEST_URI} ^/(api|uploads)(/|$) [NC,OR]
RewriteCond %{REQUEST_URI} ^/(robots\.txt|sitemap\.xml)$ [NC]
RewriteRule ^ proxy.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
